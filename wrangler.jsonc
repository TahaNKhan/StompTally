/**
 * Stomp Tally — https://steps.tahakhan.dev
 * Secrets (wrangler secret put): RESEND_API_KEY
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stomp-tally",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	"placement": { "mode": "smart" },
	"vars": {
		"APP_URL": "https://steps.tahakhan.dev",
		"MAIL_FROM": "Stomp Tally <steps@tahakhan.dev>"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "stomp-tally",
			// From `wrangler d1 create stomp-tally`. Not a secret, but change it if you fork this for your own account.
			"database_id": "b5caa823-ca2f-4211-831c-d412829c2114",
			"migrations_dir": "migrations"
		}
	],
	// Every two hours, plus 07:05 UTC = 00:05 PDT. 00:05 PST (08:05 UTC) is already an even hour.
	// Each run syncs counts first, then finalizes days whose 00:05-next-day lock has passed.
	"triggers": { "crons": ["5 */2 * * *", "5 7 * * *"] },
	"ratelimits": [
		{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
	],
	"routes": [{ "pattern": "steps.tahakhan.dev", "custom_domain": true }],
	"observability": { "enabled": true, "traces": { "enabled": true } },
	"upload_source_maps": true
}
