/**
 * Stomp Tally — https://steps.tahakhan.dev
 * Secrets (wrangler secret put): RESEND_API_KEY
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stomp-tally",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	"placement": { "mode": "smart" },
	"vars": {
		"APP_URL": "https://steps.tahakhan.dev",
		"MAIL_FROM": "Stomp Tally <steps@tahakhan.dev>"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "stomp-tally",
			// From `wrangler d1 create stomp-tally`. Not a secret, but change it if you fork this for your own account.
			"database_id": "b5caa823-ca2f-4211-831c-d412829c2114",
			"migrations_dir": "migrations"
		}
	],
	// Every 30 minutes, at :15 and :45. Each run syncs counts first, then finalizes days whose
	// 21:15 lock has passed. 21:15 Pacific is 04:15 UTC (PDT) or 05:15 UTC (PST) -- both land on a
	// :15 run, so the day locks at 21:15 rather than waiting for the next half hour. The game window
	// shuts at 21:00, so that run is also the one that carries the day's final counts.
	"triggers": { "crons": ["15,45 * * * *"] },
	"ratelimits": [
		{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
	],
	"routes": [{ "pattern": "steps.tahakhan.dev", "custom_domain": true }],
	"observability": { "enabled": true, "traces": { "enabled": true } },
	"upload_source_maps": true
}
